<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ run.project_name }} · 自动化测试报告</title>
<style>
:root{font-family:system-ui,"Microsoft YaHei",sans-serif;color:#203047;background:#f3f6fa}body{max-width:1160px;margin:32px auto;padding:0 20px}h1{font-size:28px;margin-bottom:8px}header p{color:#536579;line-height:1.8}.cards{display:flex;gap:12px;flex-wrap:wrap;margin:24px 0}.card{background:white;border:1px solid #d9e2ef;border-radius:12px;padding:16px 24px;min-width:90px}.card b{display:block;font-size:28px;margin-top:4px}.filters{display:flex;gap:12px;margin:20px 0}input,select{padding:10px;border:1px solid #becbdc;border-radius:6px;font:inherit}input{flex:1;min-width:0}article{background:white;border:1px solid #d9e2ef;border-radius:10px;padding:18px;margin:14px 0}summary{cursor:pointer;font-weight:600}.badge{border-radius:4px;padding:3px 8px;margin-right:12px;background:#eaf0f7}.passed{color:#087447;background:#e2f4eb}.failed,.error{color:#af2929;background:#ffe9e9}.skipped,.xfailed{color:#786013;background:#fff4d2}pre{white-space:pre-wrap;overflow-wrap:anywhere;padding:12px;background:#f6f8fb;font-size:13px}img{max-width:100%;border:1px solid #ddd}a{color:#175aba}small{color:#607086}li{margin:8px 0}.notice{color:#963b18}footer{margin:28px 0;color:#65758a}table{border-collapse:collapse;width:100%}td,th{padding:8px;text-align:left;border-bottom:1px solid #e0e7ef}
</style></head><body>
<header><h1>{{ run.project_name }} · 自动化测试报告</h1><p>环境：{{ run.environment }}　运行编号：{{ run.run_id }}<br>开始：{{ run.started_at }}　结束：{{ run.finished_at }}<br>页面地址：{{ run.targets.web }}<br>接口地址：{{ run.targets.api }}<br>退出码：{{ run.exit_code }}　统计耗时：{{ run.duration_ms }} 毫秒</p></header>
<div class="cards"><div class="card">用例总数<b>{{ run.cases|length }}</b></div>{% for key, label in labels.items() %}<div class="card {{ key }}">{{ label }}<b>{{ run.summary[key] }}</b></div>{% endfor %}<div class="card">通过率<b>{{ run.pass_rate }}</b></div></div>
{% if run.notice %}<p class="notice">{{ run.notice }}</p>{% endif %}
{% for error in run.session_errors %}<pre class="error">{{ error }}</pre>{% endfor %}
<div class="filters"><input id="search" aria-label="搜索用例名称" placeholder="搜索用例名称或标识"><select id="status" aria-label="筛选结果"><option value="">全部结果</option>{% for key,label in labels.items() %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></div>
<p id="count" aria-live="polite"></p>
{% for case in run.cases %}<article data-status="{{ case.status }}" data-search="{{ case.title }} {{ case.id }}"><details {% if case.status in ['failed','error'] %}open{% endif %}><summary><span class="badge {{ case.status }}">{{ labels[case.status] }}</span>{{ case.title }} <small>（{{ case.duration_ms }} 毫秒）</small></summary><p><small>{{ case.id }}</small></p>
{% if case.error %}<h3>原因与异常原文</h3><pre>{{ case.error }}</pre>{% endif %}
<h3>执行阶段</h3><table><tr><th>阶段</th><th>结果</th><th>耗时</th></tr>{% for p in case.phase_results %}<tr><td>{{ {'setup':'准备','call':'执行','teardown':'清理'}[p.phase] }}</td><td>{{ {'passed':'通过','failed':'失败','skipped':'跳过'}[p.outcome] }}</td><td>{{ p.duration_ms }} 毫秒</td></tr>{% endfor %}</table>
<h3>验证步骤</h3><ol>{% for s in case.steps %}<li><span class="badge {{ s.status }}">{{ labels[s.status] }}</span>{{ s.title }}（{{ s.duration_ms }} 毫秒）{% if s.error %}<pre>{{ s.error }}</pre>{% endif %}{% if s.response %}<pre>{{ s.response }}</pre>{% endif %}{% if s.request %}<pre>{{ s.request }}</pre>{% endif %}</li>{% else %}<li>未登记步骤；结果以用例断言和执行阶段为准。</li>{% endfor %}</ol>
{% for a in case.attachments %}<p><a href="{{ a.path }}">{{ a.title }}</a></p>{% if a.kind == 'image' %}<img src="{{ a.path }}" alt="失败现场截图">{% endif %}{% endfor %}</details></article>{% endfor %}
<footer>报告可离线查看。跳过和预期失败不计入通过率。Trace 请使用 Playwright 工具打开。</footer>
<script>
const q=document.getElementById('search'),s=document.getElementById('status');function filter(){let n=0;document.querySelectorAll('article').forEach(a=>{const show=(!s.value||a.dataset.status===s.value)&&a.dataset.search.toLowerCase().includes(q.value.toLowerCase());a.hidden=!show;if(show)n++;});document.getElementById('count').textContent='当前显示 '+n+' 条用例';}q.addEventListener('input',filter);s.addEventListener('change',filter);filter();
</script></body></html>
